# ── App ─────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-32-char-string
DEBUG=false

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite:///./data/cvforge.db

# ── Ollama ───────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# ── Frontend URL (para redirects de Stripe) ──────
FRONTEND_URL=http://localhost:3000

# ── Stripe v1.4 ──────────────────────────────────
# Obtén tus keys en: https://dashboard.stripe.com/apikeys
# Modo TEST: usa las keys que empiezan con sk_test_ / pk_test_
# Modo PROD: usa las keys que empiezan con sk_live_ / pk_live_

STRIPE_SECRET_KEY=sk_test_TU_SECRET_KEY_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_TU_PUBLISHABLE_KEY_AQUI

# Webhook secret — obténlo en Stripe Dashboard → Webhooks
# Para desarrollo local usa: stripe listen --forward-to localhost:8000/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET_AQUI

# Price IDs — créalos en Stripe Dashboard → Products
# Producto: CVForge AI Pro
# Precio mensual: s/9.00/mes → copia el Price ID (price_xxx)
# Precio anual:   s/79.00/año → copia el Price ID (price_xxx)
STRIPE_PRICE_MONTHLY=price_TU_PRICE_ID_MENSUAL
STRIPE_PRICE_YEARLY=price_TU_PRICE_ID_ANUAL

# ── CORS ─────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
